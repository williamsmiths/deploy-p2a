# Application
NODE_ENV=production
PORT=3004
APP_NAME=P2A Business Module
APP_URL=http://localhost:3004
GLOBAL_PREFIX=api/business

# Database Master (Write) - Port 5536 (docker-compose-db.yml)
DB_MASTER_HOST=postgres-business-master
DB_MASTER_PORT=5432
DB_MASTER_USERNAME=p2a_business_user
DB_MASTER_PASSWORD=P2aBusiness!2025
DB_MASTER_DATABASE=p2a_business

# Database Slave (Read) - Port 5537 (docker-compose-db.yml)
DB_SLAVE_HOST=postgres-business-slave
DB_SLAVE_PORT=5432
DB_SLAVE_USERNAME=p2a_business_user
DB_SLAVE_PASSWORD=P2aBusiness!2025
DB_SLAVE_DATABASE=p2a_business


# gRPC - Core System Connection
GRPC_CORE_SYSTEM_URL=10.220.19.210:50051

# CORS
CORS_ORIGIN=http://localhost:6000,http://localhost:6004

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Timezone (Always UTC)
TZ=UTC

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@p2a-asean.org
MAIL_FROM_NAME=P2A ASEAN Platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6378
REDIS_PASSWORD=redis
