# ==================== APPLICATION CONFIG ====================
APP_NAME=P2A CV Detection Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=3005

# ==================== DATABASE CONFIG ====================
# Connect to p2a-career database
DB_HOST=postgres-career-master
DB_PORT=5432
DB_NAME=p2a_career
DB_USER=p2a_career_user
DB_PASSWORD=P2aCareer!2025

# Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ==================== gRPC CONFIG ====================
# Core System gRPC for authentication
GRPC_CORE_SYSTEM_URL=p2a-core-system:50051
GRPC_TIMEOUT=30

# ==================== OCR CONFIG ====================
# DeepSeek OCR Model
MODEL_PATH=deepseek-ai/DeepSeek-OCR
BASE_SIZE=1024
IMAGE_SIZE=640
CROP_MODE=True
MIN_CROPS=2
MAX_CROPS=6
MAX_CONCURRENCY=100
NUM_WORKERS=64

# PDF Processing
DPI=144
IMAGE_FORMAT=PNG

# ==================== STORAGE CONFIG ====================
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# ==================== GPU CONFIG ====================
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_UTILIZATION=0.9

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ==================== SECURITY ====================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256


# ==================== GEMINI AI CONFIG ====================
# Google Gemini API for CV data extraction
# Get API key from: https://ai.google.dev/
GEMINI_API_KEY=AIzaSyDBTkdyA_43Yatz_YObrDKDsMiuc0uC9Fg
GEMINI_MODEL=gemini-2.0-flash
USE_GEMINI_EXTRACTION=True  # Set to False to use rule-based parser instead