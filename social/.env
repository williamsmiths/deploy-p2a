# App
NODE_ENV=development
PORT=3006
APP_NAME=P2A Social
APP_URL=http://localhost:3006
CORS_ORIGIN=http://localhost:8386
APP_GLOBAL_PREFIX=api/social

# Database (master)
DB_MASTER_HOST=localhost
DB_MASTER_PORT=5755
DB_MASTER_USERNAME=p2a_user
DB_MASTER_PASSWORD=p2a_social_password
DB_MASTER_DATABASE=p2a_social

DB_SYNCHRONIZE=true
DB_LOGGING=false

# gRPC - Core System Connection
GRPC_CORE_SYSTEM_URL=p2a-core-system:50051


# Redis
REDIS_HOST=localhost
REDIS_PORT=6479
REDIS_PASSWORD=redis
# Redis DB cho Socket.IO Chat/Presence (default: 5)
REDIS_DB_CHAT=5

# Webhook Configuration
WEBHOOK_SECRET=default-webhook-secret

