# Application
NODE_ENV=production
PORT=3002
APP_NAME=P2A Education Module
APP_URL=http://localhost:3002
GLOBAL_PREFIX=api/education

# Database Master (Write) - Port 5538 (docker-compose-db.yml)
DB_MASTER_HOST=localhost
DB_MASTER_PORT=5538
DB_MASTER_USERNAME=p2a_user
DB_MASTER_PASSWORD=Kx9mP2A2024MasterDB7nQ8vR3s
DB_MASTER_DATABASE=p2a_education

# Database Slave (Read) - Port 5539 (docker-compose-db.yml)
DB_SLAVE_HOST=localhost
DB_SLAVE_PORT=5539
DB_SLAVE_USERNAME=p2a_user
DB_SLAVE_PASSWORD=Kx9mP2A2024MasterDB7nQ8vR3s
DB_SLAVE_DATABASE=p2a_education


# gRPC - Core System Connection
GRPC_CORE_SYSTEM_URL=p2a-core-system:50051

# TypeORM
DB_SYNCHRONIZE=true
DB_LOGGING=false

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3004

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Timezone (Always UTC)
TZ=UTC

# Redis
REDIS_HOST=localhost
REDIS_PORT=6489
REDIS_PASSWORD=redis