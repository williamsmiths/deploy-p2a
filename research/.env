# App
NODE_ENV=development
PORT=3003
APP_NAME=P2A Research
APP_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:3003

# Database (master)
DB_MASTER_HOST=localhost
DB_MASTER_PORT=5632
DB_MASTER_USERNAME=p2a_user
DB_MASTER_PASSWORD=p2a_research_password
DB_MASTER_DATABASE=p2a_research
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Database (slave)
DB_SLAVE_HOST=postgres-research-slave
DB_SLAVE_PORT=5633
DB_SLAVE_USERNAME=p2a_user
DB_SLAVE_PASSWORD=p2a_research_password
DB_SLAVE_DATABASE=p2a_research

# gRPC Core System
GRPC_CORE_SYSTEM_URL=localhost:50051

# TypeORM
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6378
REDIS_PASSWORD=redis


